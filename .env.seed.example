# Copy to .env.seed.local (git-ignored) and run: npm run seed
# Supabase → Project Settings → API. The service role key is secret: never put it in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=office@your-school.com
ADMIN_PASSWORD=choose-a-strong-password
DEMO_PASSWORD=choose-a-demo-password
